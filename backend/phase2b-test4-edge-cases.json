		{
			"name": "Invalid Preference Tests",
			"item": [
				{
					"name": "3. Test Invalid Preference Data",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{user1Token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"eventPreferences\": {\n        \"receiveEventNotifications\": \"invalid_boolean\",\n        \"preferredCategories\": \"not_an_array\",\n        \"priceRange\": {\"min\": \"invalid_number\", \"max\": -100},\n        \"invalidField\": \"should_be_ignored\"\n    }\n}"
						},
						"url": {"raw": "{{baseUrl}}/user/event-preferences", "host": ["{{baseUrl}}"], "path": ["user", "event-preferences"]}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Invalid preferences handled gracefully', () => {",
									"    // Should either validate and reject, or sanitize and accept",
									"    if (pm.response.code === 400) {",
									"        console.log('✅ Server rejected invalid data (preferred)');",
									"    } else if (pm.response.code === 200) {",
									"        console.log('⚠️ Server accepted and sanitized invalid data');",
									"    } else {",
									"        pm.expect.fail('Unexpected response to invalid data');",
									"    }",
									"    console.log('📊 Broadcasting should still work with default preferences');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "4. Test Malformed JSON Preferences",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{user2Token}}"}
						],
						"body": {"mode": "raw", "raw": "{\"eventPreferences\": {\"receiveEventNotifications\": true, \"invalidJson\": }"},
						"url": {"raw": "{{baseUrl}}/user/event-preferences", "host": ["{{baseUrl}}"], "path": ["user", "event-preferences"]}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Malformed JSON handled', () => {",
									"    pm.expect(pm.response.code).to.equal(400);",
									"    console.log('✅ Malformed JSON properly rejected');",
									"});"
								]
							}
						}
					]
				}
			]
		},
